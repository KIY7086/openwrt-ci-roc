### 京东云亚瑟 (JDCloud RE-SS-01) 主路由配置 ###
# 代理方案：预装 Nikki（mihomo 内核，mihomo-meta 源码编译），不预装 PassWall
# Nikki feed: https://github.com/nikkinikki-org/OpenWrt-nikki (main 分支，需 OpenWrt>=24.10 + firewall4)

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

CONFIG_TESTING_KERNEL=y
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y

CONFIG_PACKAGE_nginx-full=y
CONFIG_PACKAGE_logrotate=y
CONFIG_PACKAGE_luci-app-openlist2=y

### Aria2配置项 ###

CONFIG_PACKAGE_ariang=y
CONFIG_PACKAGE_luci-app-aria2=y

CONFIG_ARIA2_OPENSSL=y
# CONFIG_ARIA2_GNUTLS is not set
# CONFIG_ARIA2_NOSSL is not set
# CONFIG_ARIA2_LIBXML2 is not set
CONFIG_ARIA2_EXPAT=y
# CONFIG_ARIA2_NOXML is not set
CONFIG_ARIA2_BITTORRENT=y
CONFIG_ARIA2_METALINK=y
CONFIG_ARIA2_SFTP=y
CONFIG_ARIA2_ASYNC_DNS=y
# CONFIG_ARIA2_COOKIE is not set
CONFIG_ARIA2_WEBSOCKET=y

### Nikki (mihomo) 配置项 ###
# nikki: 服务端脚本与防火墙集成；luci-app-nikki: LuCI 前端；mihomo-meta: mihomo 内核(PROVIDES mihomo)
CONFIG_PACKAGE_nikki=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y
CONFIG_PACKAGE_mihomo-meta=y

# Nikki 依赖（nikki 包会自动拉取，此处按官方依赖清单显式声明）
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y

# 不预装 PassWall（General.config 中已禁用，此处双保险）
CONFIG_PACKAGE_luci-app-passwall=n
CONFIG_PACKAGE_luci-app-passwall2=n
CONFIG_PACKAGE_luci-app-openclash=n

### 1G RAM + 64G eMMC 大存储豪华版 ###
# 亚瑟为 eMMC 启动设备（EmmcImage），rootfs 分区大小由此项直接控制：
# 4GiB 系统空间（squashfs + 可写 overlay），装 Nikki/插件再也不怕空间不够
CONFIG_TARGET_ROOTFS_PARTSIZE=4096

# 4GiB 之外的 ~60G 剩余空间由 Roc-script.sh 首次启动自动分区、格式化并挂载到 /mnt/data
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y

# zram 内存压缩：1G RAM 跑 mihomo + aria2 + openlist 更从容
CONFIG_PACKAGE_zram-swap=y

### 可选：Docker（数据目录指向 /mnt/data/docker，1G RAM 适合跑轻量容器）###
# CONFIG_PACKAGE_docker=y
# CONFIG_PACKAGE_docker-compose=y
# CONFIG_PACKAGE_luci-app-dockerman=y
