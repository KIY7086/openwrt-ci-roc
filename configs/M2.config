### 兆能 M2 (ZN-M2) 无线 AP 极简固件 ###
# 硬件：高通 IPQ6000 / 256MB RAM / 128MB NAND / ath11k 双频 AX1800（与和目 CMIOT AX18 同方案）
# 用途：纯无线 AP（桥接主路由京东云亚瑟）。DHCP / DNS / 防火墙 / NAT 全部由主路由承担
# 源码：laipeng668/openwrt-6.x (LibWrt) 25.12-nss 分支，内核 6.12
# 通用配置：configs/M2.General.config（极简版，不走 General.config）
# NSS 加速完整保留，q6_region 保持默认，不压缩
# AP 模式初始化：Roc-script.sh 会自动写入 uci-defaults（首次启动配置为 192.168.2.2）

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ath11k 256MB 小内存档（DTS 已带 qcom,ath11k-fw-memory-mode=<1>）
# 注：若当前源码不提供该符号，make defconfig 会自动忽略，不影响构建
CONFIG_ATH11K_MEM_PROFILE_256M=y
# NSS 保留：关闭 mesh offload 不影响常规 NSS 转发加速，仅省一点固件内存
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# NSS 固件版本跟随 LibWrt IPQ60XX 默认（11.4）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

### 极简 LuCI：只保留无线配置 / 状态 / 系统管理 ###
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

### 内核瘦身：去掉 kallsyms 符号表（约省 0.5~1MB RAM 与 flash）###
# CONFIG_KERNEL_KALLSYMS is not set

### zram 交换：防 OOM 稳压舱（空闲时几乎零开销，不需要可改 n）###
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### 负包裁剪：剔除默认包中 AP 用不到的组件 ###
# -dnsmasq/-odhcpd-ipv6only：DHCP/DNS/RA 由主路由负责
# -firewall4/-kmod-nft-offload：纯桥接 AP 不做路由过滤，省数 MB 内存
# -ppp/-ppp-mod-pppoe：无需拨号
# -luci/-luci-app-firewall：防止 LuCI 合集被默认拉入
# （负包语法与源码树内 jdcloud_re-cs-07 裁剪 ath11k 的写法一致）
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_zn_m2="-luci -luci-app-firewall -dnsmasq -odhcpd-ipv6only -ppp -ppp-mod-pppoe -firewall4 -kmod-nft-offload"

### 完整版 wpad：完整支持 802.11r 快速漫游（与京东云亚瑟组网）###
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
