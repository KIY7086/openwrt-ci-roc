### 兆能 M2 (ZN-M2) 无线 AP 固件 ###
# 硬件：高通 IPQ6000 / 256MB RAM / 128MB NAND / ath11k 双频 AX1800（与和目 CMIOT AX18 同方案）
# 策略：只精简固件本身，不做任何内置定制——出厂默认行为（IP/DHCP/无线等全部默认），
#       所有个性化配置由用户自行通过 LuCI / SSH 修改
# 无线驱动：ath11k 全套已随固件内置（kmod-ath11k/ath11k-ahb/ath11k-pci +
#       ath11k-firmware-ipq6018 + 设备校准数据 ipq-wifi-zn_m2 + wireless-regdb + 完整版 wpad）
# 源码：laipeng668/openwrt-6.x (LibWrt) 25.12-nss 分支，内核 6.12
# 通用配置：configs/M2.General.config（极简版，不走 General.config）
# NSS 加速完整保留，q6_region 保持默认，不压缩

CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_zn_m2=y

# ath11k 256MB 小内存档（已在实际构建 .config 中验证生效）
CONFIG_ATH11K_MEM_PROFILE_256M=y
# NSS 保留：仅关闭 mesh offload，不影响常规 NSS 转发加速
# CONFIG_ATH11K_NSS_MESH_SUPPORT is not set
# NSS 固件版本跟随 LibWrt IPQ60XX 默认（11.4，已验证生效）
CONFIG_NSS_FIRMWARE_VERSION_11_4=y

### LuCI 基础组件 + 简体中文 ###
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-theme-bootstrap=y

### 内核瘦身：关闭 kallsyms 符号表（已验证生效，省 ~1MB RAM）###
# CONFIG_KERNEL_KALLSYMS is not set

### zram 交换：防 OOM 稳压舱（已验证生效）###
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZ4=y
CONFIG_KERNEL_ZRAM_BACKEND_LZO=y
CONFIG_KERNEL_ZRAM_DEF_COMP_LZ4=y

### 完整版 wpad：完整支持 802.11r 快速漫游（与京东云亚瑟组网）###
# LibWrt 该设备默认即为 wpad-openssl 完整版（实际构建 .config 已确认），显式声明以求明确
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-openssl is not set
