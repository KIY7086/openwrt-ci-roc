### 兆能 M2 专用通用配置（替代 General.config，保持极简）###

CONFIG_DEVEL=y
CONFIG_CCACHE=y

# LuCI 界面语言：简体中文（自动为所有已选 LuCI 组件带上 zh-cn 翻译）
CONFIG_LUCI_LANG_zh_Hans=y

# 单设备构建，无需 initramfs
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set

# ===== NSS 说明 =====
# NSS 加速完整保留（这正是选 LibWrt NSS 固件的意义），不做任何剥离。
# q6_region 保持源码默认（55MB），不压缩，稳定优先。
